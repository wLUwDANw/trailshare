# TrailShare LLM 配置示例
#
# 用法：复制成 .env.local 再填值（.env.local 已被 .gitignore 的 *.local 规则忽略）
#   cp .env.example .env.local
#
# ⚠️ 安全警告：VITE_ 前缀的变量会被 Vite 打进前端产物。
#    也就是说，任何能打开页面的人都能在浏览器里看到这个 Key。
#    所以这套配置只适合本地演示 / 内网试用；
#    生产环境必须改成"服务端代理"：Key 留在服务端，前端只调自己的接口。
#
# 不填 Key 也能用：应用会自动走规则版回答，功能完全正常。

# OpenAI 兼容的接口地址（末尾不要带 /chat/completions）
VITE_LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key（留空 = 不启用 LLM）
VITE_LLM_API_KEY=

# 模型名，默认 deepseek-chat
VITE_LLM_MODEL=deepseek-chat
